# AGIRAILS SDK Examples - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit your actual .env file to git!

# Wallet authentication
# The SDK auto-detects your wallet using this priority:
#   1. ACTP_PRIVATE_KEY env var (if set, takes priority)
#   2. .actp/keystore.json decrypted with ACTP_KEY_PASSWORD
#
# Password to decrypt .actp/keystore.json (created by `actp wallet create`)
# Get testnet ETH from: https://www.coinbase.com/faucets/base-sepolia-faucet
ACTP_KEY_PASSWORD=your-password
#
# Optional: Raw private key (takes priority over keystore if set)
# ACTP_PRIVATE_KEY=0x...

# Optional: Custom RPC URL (defaults to public Base Sepolia RPC)
# Get free RPC from: https://www.alchemy.com/
# RPC_URL=https://base-sepolia.g.alchemy.com/v2/YOUR_KEY

# Optional: Provider address for testnet transactions
# If not set, uses a placeholder address (for demo purposes only)
# PROVIDER_ADDRESS=0x...
