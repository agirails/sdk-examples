# Network Configuration
# Options: mock | testnet | mainnet
NETWORK=mock

# Provider Agent Wallet (required for testnet/mainnet)
PROVIDER_PRIVATE_KEY=0x...

# Client Agent Wallet (required for testnet/mainnet)
CLIENT_PRIVATE_KEY=0x...

# Optional: Custom RPC URL (defaults to Base Sepolia for testnet)
# RPC_URL=https://sepolia.base.org

# Logging level (debug | info | warn | error)
LOG_LEVEL=info
